.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.board-card {
  width: 48.5%;
  background: var(--card, #161B22);
  border: 1rpx solid var(--line, #2A313C);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-top: 22rpx;
  box-sizing: border-box;
}
.board-emoji {
  font-size: 52rpx;
}
.board-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-soft, #E4CFA0);
  margin-top: 14rpx;
}
.board-desc {
  font-size: 24rpx;
  color: var(--text-dim, #8A8F98);
  margin-top: 10rpx;
  line-height: 1.5;
  min-height: 72rpx;
}
.board-go {
  font-size: 24rpx;
  margin-top: 14rpx;
}
